{
  "version": 1,
  "templates": [
    {
      "name": "JobApp",
      "emoji": "🧳",
      "workspace": "JobApp",
      "notes": "Job applications: Zen, KeePassXC, and herdr running inside a terminal.",
      "apps": [
        {
          "name": "Zen Browser",
          "cmd": "/opt/zen-browser-bin/zen-bin",
          "appId": "zen"
        },
        {
          "name": "KeePassXC",
          "cmd": "keepassxc",
          "appId": "org.keepassxc.KeePassXC"
        },
        {
          "name": "herdr",
          "cmd": "ghostty -e herdr",
          "appId": "com.mitchellh.ghostty"
        }
      ]
    },
    {
      "name": "Dev Work",
      "emoji": "💻",
      "workspace": "Dev Work",
      "notes": "",
      "apps": [
        {
          "name": "gitcomet",
          "cmd": "gitcomet",
          "appId": "gitcomet"
        },
        {
          "name": "dev.zed.Zed",
          "cmd": "/usr/lib/zed/zed-editor zed-cli:///tmp/.tmpL8pXTR/socket",
          "appId": "dev.zed.Zed"
        },
        {
          "name": "gcr-prompter",
          "cmd": "/usr/lib/gcr-prompter",
          "appId": "gcr-prompter"
        }
      ]
    }
  ]
}
